# Copy to .env to override defaults.
# GPUS=0,2,1                     # three cards in pipeline order; on 64/64/40 put the 40 GB card second
# LAYER_PARTITION=15,10,15       # layers per card (40 in all); 13,14,13 on three 64 GB cards
# GPU_MEMORY_UTILIZATION=0.97
# MAX_NUM_SEQS=4
# HOST=127.0.0.1
# PORT=8000
# MODELS_DIR=/path/to/models     # the checkpoint and the Engram tables; use a fast SSD
# CACHE_DIR=/path/to/cache       # compiled kernels and graphs; keep between starts
# IMAGE=ghcr.io/alexbrandes/cmp170hx-dsv41-flash-a4nx@sha256:...
